{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "credsey",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/*", "!/assets/*", "!/img/*", "!/favicon.ico"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "kv_namespaces": [{ "binding": "KV", "id": "a61324d9c9da4bb995958b9dd284d912" }],
  "d1_databases": [{ "binding": "DB", "database_name": "credsey-db", "database_id": "6d79b8e0-c1d8-45b7-b8a5-314c94389ddd" }],
  "routes": [
    { "pattern": "credsey.com", "custom_domain": true },
    { "pattern": "www.credsey.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
